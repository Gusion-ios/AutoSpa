# Copia como .env.production en la VM y reemplaza todos los valores de ejemplo.
# No subas .env.production al repositorio.
PUBLIC_DOMAIN=autospa.example.com
CADDY_EMAIL=admin@example.com
VITE_API_URL=/api
VITE_PUBLIC_APP_URL=https://autospa.example.com/
AUTOSPA_CORS_ALLOWED_ORIGINS=https://autospa.example.com
FRONTEND_BIND=127.0.0.1
GATEWAY_BIND=127.0.0.1

POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_ALEATORIA
AUTOSPA_JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
AUTOSPA_GATEWAY_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
AUTOSPA_SUPERADMIN_EMAIL=admin@example.com
AUTOSPA_SUPERADMIN_PASSWORD=CAMBIAR_POR_LA_CLAVE_DEL_ADMIN
AUTOSPA_SUPERADMIN_NAME=Administrador Supremo
GATEWAY_MODE=block
GATEWAY_RATE_LIMIT_PER_MINUTE=120

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_DAYS=28
AZURE_BLOB_CONTAINER_URL=
AZURE_BLOB_SAS_TOKEN=
